       */
      atom_id_1: str2,
      /**
       * The atom identifier/name in the second of the two components making
       * the linkage.
       */
      atom_id_2: str2,
      /**
       * The bond order target for the non-standard linkage.
       */
      value_order: Aliased(lstr)
    },
    /**
